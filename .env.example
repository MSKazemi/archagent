# ArchAgent environment example
# Copy to .env or set these variables in your systemd unit/shell.

# Required for any non-local/demo deployment. Use a long random value.
ARCHAGENT_TOKEN=change-me-use-openssl-rand-hex-32

# Legacy admin portal login (form-based /admin/* pages). Optional; superseded by
# the user-account control plane below. Set ADMIN_PASS to keep it enabled.
# ADMIN_USER=admin
# ADMIN_PASS=choose-a-strong-password

# ─── Identity / RBAC control plane ───────────────────────────────────────────
# First admin user, seeded on first run only if no users exist yet. After bootstrap,
# manage users from the admin console (Security tab) — these vars are ignored.
# Must be at least 12 characters and not a well-known default — the server refuses to
# start on a non-loopback bind otherwise. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# ARCHAGENT_ADMIN_EMAIL=admin@yourcompany.com
# ARCHAGENT_ADMIN_PASSWORD=
#
# Session cookie lifetime (hours) and whether the legacy single ARCHAGENT_TOKEN
# still authenticates as an admin-equivalent principal (default on).
# ARCHAGENT_SESSION_TTL_HOURS=8
# ARCHAGENT_LEGACY_TOKEN_ENABLED=1
# ARCHAGENT_SECURE_COOKIES=auto   # auto|1|0 — auto adds Secure off localhost
#
# Rate-limit tier overrides: "<capacity>,<refill_per_sec>".
# ARCHAGENT_RL_DEFAULT=60,5.0
# ARCHAGENT_RL_WRITE=30,1.0
# ARCHAGENT_RL_EXPENSIVE=6,0.1
#
# Database path overrides (useful for tests / alternate deployments).
# ARCHAGENT_APP_DB=/path/to/archagent_app.sqlite3
# ARCHAGENT_LEADS_DB=/path/to/archagent_actionable_projects.sqlite3

# Optional: enable Hermes proposal enhancement endpoint.
# HERMES_PROPOSAL_ENABLED=1

# Azure OpenAI — required for POST /api/dossier/analyze (analyst.py)
# Uses the Responses API (api-version 2025-04-01-preview or later).
# AZURE_OPENAI_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# SMTP — optional. Required to receive email alerts for pilot requests.
# Gmail example: host=smtp.gmail.com port=587 user=you@gmail.com pass=app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com
# NOTIFY_EMAIL=you@gmail.com

# Default local API port used by archagent_server.py examples.
ARCHAGENT_HOST=127.0.0.1
ARCHAGENT_PORT=8091
ARCHAGENT_HEALTH_HOST=127.0.0.1
