[Unit]
Description=ArchAgent BuildingOS API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/archagent
EnvironmentFile=-/opt/archagent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/archagent/archagent_server.py --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/archagent

[Install]
WantedBy=multi-user.target
