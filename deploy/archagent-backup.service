[Unit]
Description=ArchAgent database backup (both DBs + exports, integrity-verified, pruned)
Documentation=https://github.com/MSKazemi/archagent
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/archagent
EnvironmentFile=-/opt/archagent/.env
ExecStart=/usr/bin/python3 /opt/archagent/ops/backup.py --include-exports --keep 30
User=archagent
Group=archagent
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/opt/archagent
